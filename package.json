{
  "name": "wobbly-cargo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node tools/size-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "e2e": "playwright test",
    "art": "node tools/art-build.mjs",
    "art:preview": "node tools/art-preview.mjs",
    "levels:verify": "tsx tools/levels-verify.mjs",
    "zip": "node tools/zip.mjs",
    "audio": "node tools/audio.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "planck": "^1.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
